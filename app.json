{
  "expo": {
    "name": "Barkits",
    "slug": "barkits",
    "scheme": "barkits",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Barkits uses your location when you choose a starting point for a meetup.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ]
    ],
    "userInterfaceStyle": "light"
  }
}
